# ── Supabase ──────────────────────────────────────────────
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — bypasses RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI tools (CV checker, interview) — Google Gemini, bring-your-own key ──
# Each member adds her own Google API key in-app (/ai/keys); keys are stored
# encrypted. AI_KEY_SECRET is the server-side encryption secret — set it to a
# long random string in production (e.g. `openssl rand -base64 48`).
AI_KEY_SECRET=change-me-to-a-long-random-string

# ── Payments: Nedarim Plus (נדרים פלוס) — server only ──
NEDARIM_MOSAD_ID=
NEDARIM_API_VALID=
# Public base URL (used for the Nedarim server CallBack). e.g. https://app.opencode.org.il
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Email — Google Apps Script sender (server only) ──
# The /exec URL of the deployed Apps Script web app (scripts/google-apps-script/).
APPS_SCRIPT_EMAIL_URL=
# Shared secret — must match the SECRET constant inside Code.gs.
APPS_SCRIPT_EMAIL_SECRET=
# Supabase "Send Email Hook" secret (Authentication → Hooks). Format: v1,whsec_...
SEND_EMAIL_HOOK_SECRET=

# ── Payments: webhook authentication (server only) ──
# The Nedarim CallBack is the ONLY thing that can turn a member into a paying
# one, and nothing in the iframe payload can authenticate it (Mosad/ApiValid and
# the CallBack URL all travel through her browser). So the CallBack URL is
# configured in the Nedarim ACCOUNT as:
#   https://<site>/api/webhooks/payments?key=<NEDARIM_CALLBACK_SECRET>
# Without this set, the webhook refuses to activate anyone — on purpose.
NEDARIM_CALLBACK_SECRET=
# Optional extra layer: comma-separated IPs Nedarim calls from, when known.
NEDARIM_CALLBACK_IPS=

# ── Email — Resend (server only) ──
# Powers every application email (submission, status, mentor, client invites).
RESEND_API_KEY=
# The From address on those emails, e.g. "קוד פתוח <hi@opencode.org.il>"
EMAIL_FROM=

# ── Scheduled jobs (server only) ──
# Shared secret for /api/cron/* — drive-sync, subscriptions, daily-digest.
CRON_SECRET=

# ── Employer portal (server only) ──
# Signs the portal client's session cookie. WITHOUT IT THE PORTAL CANNOT LOG IN:
# the cookie is written but never accepted, so the client bounces on the login
# page forever. Set it to a long random string.
PORTAL_SESSION_SECRET=

# ── Google Drive automation (server only, optional) ──
# Shares course/session material with members automatically and revokes it when
# they leave. Unset = the manual share queue in ניהול ← תור שיתופים.
# Full setup: docs/drive-automation.md
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
